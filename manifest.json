{
  "manifest_version": 3,
  "name": "pd4git",
  "version": "0.1.0",
  "description": "Shows Pure Data (.pd) patches as graphs on GitHub, GitLab and Codeberg.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://gitlab.com/*", "https://codeberg.org/*"],
      "js": ["src/content.js"],
      "css": ["src/style.css"]
    }
  ],
  "firefox:browser_specific_settings": {
    "gecko": { "id": "pd4git@pd4git", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
